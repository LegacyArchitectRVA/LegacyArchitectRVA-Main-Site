# Security headers.
# script-src/style-src use 'unsafe-inline' to match what's actually live in production.
# If you later want to move to the stricter hash-locked policy (recommended long-term,
# each inline <script>/<style> block allowlisted by exact SHA-256 hash instead of blanket
# 'unsafe-inline'), that requires regenerating hashes after every single edit to any
# inline script or style block, on every page. Doable, but only worth it if you're
# committing to running gen_csp.py (or equivalent) after every future change - otherwise
# the hashes silently go stale and start blocking real functionality, same failure mode
# this fix addresses now.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://downloads.legacyarchitectrva.com https://www.google-analytics.com; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com; connect-src 'self' https://elara-ai.craig-a51.workers.dev https://usable-hornet-255.convex.cloud wss://usable-hornet-255.convex.cloud https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://api.hsforms.com https://cloudflareinsights.com https://hook.us2.make.com; frame-src https://cal.com https://app.cal.com https://js.stripe.com https://buy.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://buy.stripe.com; object-src 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable
